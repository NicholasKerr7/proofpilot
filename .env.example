# Shared
NODE_ENV=development

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000

# API
PORT=4000
WEB_ORIGIN=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-secret

# Auth sessions, password recovery, and collaboration invitations.
# Production requires Resend delivery.
AUTH_SESSION_TTL_DAYS=7
PASSWORD_RESET_DELIVERY_MODE=log
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
PASSWORD_RESET_REQUEST_COOLDOWN_SECONDS=60
# RESEND_API_KEY=
# AUTH_EMAIL_FROM=ProofPilot <security@example.com>

# Database
DATABASE_URL=postgresql://proofpilot:proofpilot@localhost:5432/proofpilot?schema=public

# Queue
REDIS_URL=redis://localhost:6379

# API protection and proxy handling
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
TRUST_PROXY=false

# Optional API error monitoring webhook
ERROR_MONITORING_ENVIRONMENT=development
# ERROR_MONITORING_WEBHOOK_URL=

# Upload malware scanning. Production requires clamav.
VIRUS_SCAN_MODE=disabled
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=60000

# Worker OCR
OCR_LANGUAGES=eng
OCR_CACHE_PATH=/tmp/proofpilot-ocr
# TESSERACT_LANG_PATH can point to a local path or URL containing traineddata files.
# TESSERACT_LANG_PATH=

# S3-compatible storage, backed by MinIO locally
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=proofpilot-evidence
STORAGE_ACCESS_KEY_ID=proofpilot
STORAGE_SECRET_ACCESS_KEY=proofpilot-secret
STORAGE_FORCE_PATH_STYLE=true

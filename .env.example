# Shared
NODE_ENV=development

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000

# API
PORT=4000
WEB_ORIGIN=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-secret

# Database
DATABASE_URL=postgresql://proofpilot:proofpilot@localhost:5432/proofpilot?schema=public

# Queue
REDIS_URL=redis://localhost:6379

# S3-compatible storage, backed by MinIO locally
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=proofpilot-evidence
STORAGE_ACCESS_KEY_ID=proofpilot
STORAGE_SECRET_ACCESS_KEY=proofpilot-secret
STORAGE_FORCE_PATH_STYLE=true

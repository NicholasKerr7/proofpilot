generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum CaseStatus {
  DRAFT
  COLLECTING_EVIDENCE
  PROCESSING
  NEEDS_MORE_EVIDENCE
  READY_FOR_REVIEW
  PACKET_GENERATED
  SUBMITTED
  RESOLVED
  ARCHIVED
}

enum DocumentStatus {
  UPLOADED
  PROCESSING
  PROCESSED
  FAILED
  NEEDS_REVIEW
}

enum PacketStatus {
  NOT_STARTED
  GENERATING
  READY
  FAILED
  DOWNLOADED
}

enum ChecklistStatus {
  MISSING
  FOUND
  NEEDS_REVIEW
  OPTIONAL
  COMPLETE
}

enum SupportRequestCategory {
  CASE_ASSISTANCE
  ACCOUNT_ACCESS
  BILLING
  TECHNICAL
  SECURITY_PRIVACY
  OTHER
}

enum SupportRequestPriority {
  LOW
  NORMAL
  HIGH
}

enum SupportRequestStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum SupportMessageAuthor {
  USER
  SUPPORT
  SYSTEM
}

enum ConnectionProvider {
  GMAIL
  GOOGLE_DRIVE
  DROPBOX
  PAYPAL
  ONEDRIVE
  BOX
}

enum ConnectionMode {
  DEMO
  OAUTH
}

enum BillingMode {
  DEMO
  STRIPE
}

enum BillingPlan {
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum InvoiceStatus {
  PAID
  OPEN
  VOID
}

enum AssistantMessageRole {
  USER
  ASSISTANT
}

enum AssistantResponseMode {
  GUIDED
  MODEL
}

enum CaseCollaboratorRole {
  EDITOR
  VIEWER
}

enum CaseCollaboratorStatus {
  PENDING
  ACTIVE
}

enum PacketSharePermission {
  VIEW
  COMMENT
  DOWNLOAD
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  name                String?
  passwordHash        String
  passwordChangedAt   DateTime             @default(now())
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  preference          UserPreference?
  billingSubscription BillingSubscription?
  connectedAccounts   ConnectedAccount[]
  cases               Case[]
  auditLogs           AuditLog[]
  supportRequests     SupportRequest[]
  assistantThreads    AssistantThread[]
  caseCollaborations  CaseCollaborator[]   @relation("CaseCollaboratorUser")
  packetSharesCreated PacketShare[]        @relation("PacketShareCreator")
}

model UserPreference {
  id                       String     @id @default(cuid())
  userId                   String     @unique
  user                     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  autoSave                 Boolean    @default(true)
  confirmBeforeDelete      Boolean    @default(true)
  defaultCaseStatus        CaseStatus @default(DRAFT)
  itemsPerPage             Int        @default(25)
  emailNotifications       Boolean    @default(true)
  inAppNotifications       Boolean    @default(true)
  notifyCaseUpdates        Boolean    @default(true)
  notifyDeadlineReminders  Boolean    @default(true)
  notifyEvidenceProcessing Boolean    @default(true)
  notifyPacketReady        Boolean    @default(true)
  theme                    String     @default("DARK")
  accentColor              String     @default("COPPER")
  reduceMotion             Boolean    @default(false)
  cloudSync                Boolean    @default(true)
  syncOverCellular         Boolean    @default(false)
  exportFormat             String     @default("PDF")
  analyticsUsageData       Boolean    @default(false)
  marketingCommunications  Boolean    @default(false)
  lastSyncedAt             DateTime   @default(now())
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt
}

model ConnectedAccount {
  id           String             @id @default(cuid())
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     ConnectionProvider
  mode         ConnectionMode     @default(DEMO)
  accountLabel String?
  connectedAt  DateTime           @default(now())
  lastSyncedAt DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([userId, provider])
  @@index([userId, updatedAt])
}

model BillingSubscription {
  id                 String             @id @default(cuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode               BillingMode        @default(DEMO)
  plan               BillingPlan        @default(PREMIUM)
  status             SubscriptionStatus @default(ACTIVE)
  priceCents         Int
  currency           String             @default("USD")
  billingCycle       BillingCycle       @default(MONTHLY)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean            @default(false)
  paymentBrand       String?
  paymentLast4       String?
  paymentExpMonth    Int?
  paymentExpYear     Int?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  invoices           BillingInvoice[]

  @@index([status, currentPeriodEnd])
}

model BillingInvoice {
  id              String              @id @default(cuid())
  subscriptionId  String
  subscription    BillingSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  invoiceNumber   String
  periodStart     DateTime
  periodEnd       DateTime
  issuedAt        DateTime
  amountPaidCents Int
  currency        String              @default("USD")
  status          InvoiceStatus       @default(PAID)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([subscriptionId, invoiceNumber])
  @@index([subscriptionId, issuedAt])
}

model CaseType {
  id          String         @id @default(cuid())
  slug        String         @unique
  name        String
  description String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  cases       Case[]
  templates   CaseTemplate[]
}

model Case {
  id               String               @id @default(cuid())
  ownerId          String
  owner            User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  caseTypeId       String
  caseType         CaseType             @relation(fields: [caseTypeId], references: [id])
  title            String
  platform         String
  summary          String?
  status           CaseStatus           @default(DRAFT)
  deadline         DateTime?
  archivedAt       DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  documents        Document[]
  events           CaseEvent[]
  checklist        CaseChecklistItem[]
  statements       CaseStatement[]
  summaries        CaseSummary[]
  packets          CasePacket[]
  reminders        Reminder[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  supportRequests  SupportRequest[]
  assistantThreads AssistantThread[]
  collaborators    CaseCollaborator[]
  sharingSettings  CaseSharingSettings?
  packetShares     PacketShare[]

  @@index([ownerId, status])
  @@index([caseTypeId])
}

model CaseCollaborator {
  id         String                 @id @default(cuid())
  caseId     String
  case       Case                   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?                  @relation("CaseCollaboratorUser", fields: [userId], references: [id], onDelete: SetNull)
  email      String
  name       String?
  role       CaseCollaboratorRole
  status     CaseCollaboratorStatus @default(PENDING)
  invitedAt  DateTime               @default(now())
  expiresAt  DateTime?
  acceptedAt DateTime?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  @@unique([caseId, email])
  @@index([caseId, status])
  @@index([userId, status])
}

model CaseSharingSettings {
  id                   String   @id @default(cuid())
  caseId               String   @unique
  case                 Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  preventDownloads     Boolean  @default(false)
  invitationExpiryDays Int      @default(7)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Document {
  id                 String                  @id @default(cuid())
  caseId             String
  case               Case                    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  originalName       String
  mimeType           String
  byteSize           Int
  storageKey         String
  status             DocumentStatus          @default(UPLOADED)
  extractedText      String?
  quarantinedAt      DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  versions           DocumentVersion[]
  entities           DocumentEntity[]
  processingLogs     DocumentProcessingLog[]
  eventSources       EventSource[]
  requirementMatches CaseRequirementMatch[]

  @@index([caseId, status])
}

model DocumentVersion {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version    Int
  storageKey String
  createdAt  DateTime @default(now())

  @@unique([documentId, version])
}

model DocumentEntity {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  type       String
  value      String
  confidence Float?
  createdAt  DateTime @default(now())

  @@index([documentId, type])
}

model DocumentProcessingLog {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  step       String
  status     String
  message    String?
  createdAt  DateTime @default(now())
}

model CaseEvent {
  id          String        @id @default(cuid())
  caseId      String
  case        Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  sortOrder   Int           @default(0)
  occurredAt  DateTime
  title       String
  description String?
  confidence  Float?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  sources     EventSource[]

  @@index([caseId, occurredAt])
  @@index([caseId, sortOrder])
}

model EventSource {
  id         String    @id @default(cuid())
  eventId    String
  event      CaseEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  documentId String
  document   Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  @@unique([eventId, documentId])
}

model CaseTemplate {
  id           String                @id @default(cuid())
  caseTypeId   String
  caseType     CaseType              @relation(fields: [caseTypeId], references: [id], onDelete: Cascade)
  name         String
  description  String
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  requirements TemplateRequirement[]
}

model TemplateRequirement {
  id          String                 @id @default(cuid())
  templateId  String
  template    CaseTemplate           @relation(fields: [templateId], references: [id], onDelete: Cascade)
  label       String
  description String
  required    Boolean                @default(true)
  sortOrder   Int                    @default(0)
  checklist   CaseChecklistItem[]
  matches     CaseRequirementMatch[]
}

model CaseChecklistItem {
  id            String                 @id @default(cuid())
  caseId        String
  case          Case                   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  requirementId String?
  requirement   TemplateRequirement?   @relation(fields: [requirementId], references: [id])
  label         String
  description   String
  status        ChecklistStatus        @default(MISSING)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  matches       CaseRequirementMatch[]

  @@index([caseId, status])
}

model CaseRequirementMatch {
  id              String              @id @default(cuid())
  requirementId   String
  requirement     TemplateRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  checklistItemId String?
  checklistItem   CaseChecklistItem?  @relation(fields: [checklistItemId], references: [id])
  documentId      String
  document        Document            @relation(fields: [documentId], references: [id], onDelete: Cascade)
  confidence      Float
  rationale       String?
  createdAt       DateTime            @default(now())
}

model CaseStatement {
  id        String             @id @default(cuid())
  caseId    String
  case      Case               @relation(fields: [caseId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  versions  StatementVersion[]
}

model StatementVersion {
  id          String        @id @default(cuid())
  statementId String
  statement   CaseStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  content     String
  version     Int
  createdAt   DateTime      @default(now())

  @@unique([statementId, version])
}

model CaseSummary {
  id        String   @id @default(cuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AssistantThread {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  caseId    String
  case      Case               @relation(fields: [caseId], references: [id], onDelete: Cascade)
  title     String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  messages  AssistantMessage[]

  @@unique([userId, caseId])
  @@index([caseId, updatedAt])
}

model AssistantMessage {
  id                 String                 @id @default(cuid())
  threadId           String
  thread             AssistantThread        @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role               AssistantMessageRole
  content            String
  responseMode       AssistantResponseMode?
  model              String?
  promptTokens       Int?
  completionTokens   Int?
  estimatedCostCents Int?
  createdAt          DateTime               @default(now())

  @@index([threadId, createdAt])
}

model CasePacket {
  id        String         @id @default(cuid())
  caseId    String
  case      Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  status    PacketStatus   @default(NOT_STARTED)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  exports   PacketExport[]
}

model PacketExport {
  id         String        @id @default(cuid())
  packetId   String
  packet     CasePacket    @relation(fields: [packetId], references: [id], onDelete: Cascade)
  storageKey String
  byteSize   Int?
  createdAt  DateTime      @default(now())
  shares     PacketShare[]
}

model PacketShare {
  id                       String                 @id @default(cuid())
  caseId                   String
  case                     Case                   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  packetExportId           String
  packetExport             PacketExport           @relation(fields: [packetExportId], references: [id], onDelete: Cascade)
  createdById              String
  createdBy                User                   @relation("PacketShareCreator", fields: [createdById], references: [id], onDelete: Cascade)
  tokenHash                String                 @unique
  expiresAt                DateTime?
  requireEmailVerification Boolean                @default(false)
  watermarkDocuments       Boolean                @default(false)
  revokedAt                DateTime?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  recipients               PacketShareRecipient[]
  comments                 PacketShareComment[]

  @@index([caseId, createdAt])
  @@index([packetExportId])
}

model PacketShareRecipient {
  id             String                @id @default(cuid())
  shareId        String
  share          PacketShare           @relation(fields: [shareId], references: [id], onDelete: Cascade)
  email          String
  permission     PacketSharePermission @default(VIEW)
  lastAccessedAt DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  comments       PacketShareComment[]

  @@unique([shareId, email])
  @@index([shareId, permission])
}

model PacketShareComment {
  id          String               @id @default(cuid())
  shareId     String
  share       PacketShare          @relation(fields: [shareId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   PacketShareRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  content     String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([shareId, createdAt])
  @@index([recipientId, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  caseId    String?
  case      Case?     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  userId    String
  type      String
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

model Reminder {
  id          String    @id @default(cuid())
  caseId      String
  case        Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  remindAt    DateTime
  message     String
  sentAt      DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([caseId, remindAt])
}

model Job {
  id        String   @id @default(cuid())
  queueName String
  jobName   String
  status    String
  payload   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  caseId    String?
  case      Case?    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, action, createdAt])
  @@index([caseId])
}

model SupportRequest {
  id        String                  @id @default(cuid())
  userId    String
  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  caseId    String?
  case      Case?                   @relation(fields: [caseId], references: [id], onDelete: SetNull)
  category  SupportRequestCategory
  subject   String
  message   String
  priority  SupportRequestPriority  @default(NORMAL)
  status    SupportRequestStatus    @default(OPEN)
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  messages  SupportRequestMessage[]

  @@index([userId, updatedAt])
  @@index([caseId])
  @@index([status, createdAt])
}

model SupportRequestMessage {
  id        String               @id @default(cuid())
  requestId String
  request   SupportRequest       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author    SupportMessageAuthor @default(USER)
  message   String
  createdAt DateTime             @default(now())

  @@index([requestId, createdAt])
}

{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "apps/worker/**",
      "packages/database/**",
      "packages/storage/**",
      "packages/types/**",
      "Dockerfile",
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "tsconfig.base.json",
      "turbo.json"
    ]
  },
  "deploy": {
    "drainingSeconds": 30,
    "overlapSeconds": 0,
    "restartPolicyMaxRetries": 10,
    "restartPolicyType": "ALWAYS",
    "startCommand": "node apps/worker/dist/main.js"
  }
}
